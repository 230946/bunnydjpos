# ─────────────────────────────────────────────────
# BUNNYDJPOS — Variables de entorno para MariaDB/XAMPP
# Copia este archivo como .env
# ─────────────────────────────────────────────────

# Motor: 'mysql' para MariaDB/MySQL (XAMPP) | 'pg' para PostgreSQL
DB_TYPE=mysql

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=bunnydjpos

PORT=3001

JWT_SECRET=CAMBIA_ESTO_POR_UNA_CADENA_ALEATORIA_LARGA
JWT_EXPIRES=8h

SUPERADMIN_EMAIL=superadmin@bunnydjpos.com
SUPERADMIN_PASS=CAMBIA_ESTO_POR_UNA_CLAVE_FUERTE

# El superadmin es el usuario maestro: el único que restablece claves de
# administradores. Usa un correo real y una clave de 12 caracteres o más.

ALLOWED_ORIGIN=*
UPLOADS_DIR=./uploads

# Dirección pública del sistema: con ella se arman los enlaces de los correos
# (recuperar contraseña). En tu PC: PUBLIC_URL=http://localhost:3001
PUBLIC_URL=https://djmpos.com


# ── ATRIL (lector de PDF en /atril, se entra con el usuario de DJMPOS) ──
# Carpeta donde se guardan los PDFs y notas de cada usuario (por defecto backend/atril-data)
# ATRIL_DIR=/home/bunnyburgerdj/atril-data
